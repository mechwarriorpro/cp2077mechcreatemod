{
  "schemaVersion": 1,
  "description": "Player-designed internal subsystems. Every component exposes powerDraw, mass, heatGen, heatDiss, rcs, ecm.",
  "categories": {
    "power_bus": {
      "label": "Power bus / mana distribution",
      "short": "POWER BUS",
      "color": "#ffd166",
      "description": "Conduits, fuses, capacitor bank and routing that move reactor output to every subsystem.",
      "params": [
        {
          "key": "busCapacity",
          "label": "Bus capacity",
          "unit": "kW",
          "min": 0,
          "max": 600,
          "step": 5,
          "default": 180,
          "help": "Total conduit throughput."
        },
        {
          "key": "conduitGauge",
          "label": "Conduit gauge",
          "unit": "AWG",
          "min": 1,
          "max": 20,
          "step": 1,
          "default": 8,
          "help": "Thicker conduit = less loss, more mass."
        },
        {
          "key": "voltage",
          "label": "Voltage",
          "unit": "V",
          "min": 12,
          "max": 480,
          "step": 4,
          "default": 120,
          "help": "Higher voltage lowers resistive loss."
        },
        {
          "key": "routingRedundancy",
          "label": "Routing redundancy",
          "unit": "paths",
          "min": 0,
          "max": 6,
          "step": 1,
          "default": 1,
          "help": "Extra paths resist battle damage and brownout."
        },
        {
          "key": "fuseLimit",
          "label": "Fuse limit",
          "unit": "kW",
          "min": 20,
          "max": 600,
          "step": 5,
          "default": 170,
          "help": "Brownout threshold for the bus."
        },
        {
          "key": "capacitorBank",
          "label": "Capacitor bank",
          "unit": "kJ",
          "min": 0,
          "max": 200,
          "step": 2,
          "default": 24,
          "help": "Surge tolerance for burst abilities."
        },
        {
          "key": "grounding",
          "label": "Grounding quality",
          "unit": "0-1",
          "min": 0,
          "max": 1,
          "step": 0.01,
          "default": 0.7,
          "help": "Reduces ECM self-noise and quickhack susceptibility."
        }
      ],
      "derived": [
        "brownoutThreshold",
        "surgeTolerance",
        "transmissionLoss"
      ]
    },
    "thermal_loop": {
      "label": "Thermal loop",
      "short": "THERMAL",
      "color": "#ff7b54",
      "description": "Coolant, pumps, radiator area, heat pipes and phase-change mass. Radiators cost RCS.",
