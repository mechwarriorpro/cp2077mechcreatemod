  "validationStates": [
    {
      "code": "BROWNOUT",
      "severity": "critical",
      "detail": "powerMargin < 0 — abilities fail, HUD flickers, weapon damage derates."
    },
    {
      "code": "THERMAL SATURATION",
      "severity": "critical",
      "detail": "Heat generation exceeds dissipation; weapons derate and vents open."
    },
    {
      "code": "OVER MASS",
      "severity": "warning",
      "detail": "Mass above reference budget — speed, dash and jump are penalised."
    },
    {
      "code": "COM OFFSET",
      "severity": "warning",
      "detail": "Centre of mass is outside the stability envelope; recoil drift and screen shake."
    },
    {
      "code": "STRUCTURAL STRESS",
      "severity": "warning",
      "detail": "Hardpoint and armour loading exceeds bracing capacity."
    },
    {
      "code": "RCS EXPOSURE",
      "severity": "warning",
      "detail": "High radar cross section — hostiles detect and lock faster."
    },
    {
      "code": "ECM SELF-DETECTION",
      "severity": "warning",
      "detail": "Jamming paints you as a target; self-emissions dominate the signature."
    },
    {
      "code": "MANA STARVATION",
      "severity": "warning",
      "detail": "Atmospheric harvest and growth pool cannot sustain the requested flow."
    },
    {
      "code": "LATTICE OVERFLOW",
      "severity": "critical",
      "detail": "Containment lattice is driven beyond its design flux."
    },
    {
      "code": "CRYSTAL RESONANCE",
      "severity": "warning",
      "detail": "Crystal size/flow resonance adds signature and surge risk."
    },
    {
      "code": "CONTAINMENT FAILURE",
      "severity": "critical",
      "detail": "Instability > threshold; surges, forced vent, meltdown / Protocol 3 eject."
    },
    {
      "code": "HARDPOINT OVERFLOW",
      "severity": "warning",
      "detail": "More hardpoints than the frame can brace."
    },
    {
      "code": "BUS OVERDRAW",
      "severity": "critical",
      "detail": "Part power draw plus transfer loss exceeds the routed bus capacity — brownouts at the node."
    },
    {
      "code": "COOLANT SATURATION",
      "severity": "critical",
      "detail": "Routed heat generation exceeds coolant loop capacity — the part derates and vents."
    },
    {
      "code": "HOT SPOT",
      "severity": "warning",
      "detail": "A single mounting bay generates more heat than its local dissipation plus loop share."
    },
    {
      "code": "TRANSFER LOSS",
      "severity": "warning",
      "detail": "Long bus/coolant runs waste power as heat; shorten routes or add capacitors."
    },
    {
      "code": "UNROUTED NODE",
      "severity": "warning",
      "detail": "A mounted part has no bus or coolant route assigned."
    }
  ],
  "keyBindings": {
    "move": "W A S D",
    "aim": "Mouse",
    "fire": "LMB",
    "abilities": "Q / E / R",
    "dash": "Shift",
    "companion": "1 - 4",
    "pause": "P",
    "vent": "V"
  },
  "equations": [
    {
      "id": "powerUsed",
      "label": "Power budget",
      "formula": "powerUsed = Σ subsystem.powerDraw"
    },
    {
      "id": "powerMargin",
      "label": "Power margin",
      "formula": "powerMargin = reactor.netOutput - powerUsed   // <0 => BROWNOUT"
    },
    {
      "id": "totalMass",
      "label": "Total mass",
      "formula": "totalMass = frame.mass + Σ part.mass + payload"
    },
    {
      "id": "speed",
      "label": "Speed",
      "formula": "speed = baseSpeed * (1 - k1*totalMass/massRef) * (1 - k2*structuralStress)"
    },
    {
      "id": "heatGen",
      "label": "Heat generated",
      "formula": "heatGen = reactor.heat + Σ part.heatGen + movementHeat + ecmHeat"
    },
    {
      "id": "heatDiss",
      "label": "Heat dissipated",
      "formula": "heatDiss = Σ radiator.area * coolantFlow * efficiency"
    },
    {
      "id": "netHeat",
      "label": "Net heat",
      "formula": "netHeat = heatGen - heatDiss"
    },
    {
      "id": "temperature",
      "label": "Temperature",
      "formula": "temperature += netHeat * dt / thermalMass   // >1 => DERATE / VENT / MELTDOWN"
    },
    {
      "id": "rcs",
      "label": "Radar cross section",
      "formula": "rcs = shapeFactor(facets, torsoW, limbStance) * materialFactor(RAM, coating) + crystalSignature(S, η) + activeEmissions(jammer, radar, charge)"
    },
    {
      "id": "detectRange",
      "label": "Detection range",
      "formula": "detectRange = k * sqrt(rcs) * enemySensorFactor"
    },
    {
      "id": "jamStrength",
      "label": "Jam strength",
      "formula": "jamStrength = jammerPower * antennaGain / (dist^2 * enemyECCM)"
    },
    {
      "id": "lockBreak",
      "label": "Lock break",
      "formula": "lockBreak = clamp(jamStrength - enemyLockQuality, 0, 1)"
    },
    {
      "id": "selfEmissions",
      "label": "Self emissions",
      "formula": "selfEmissions = jammerPower * (LPI ? 0.25 : 1.0)   // jamming makes you visible"
    },
    {
      "id": "bus_transfer",
      "label": "Bus transfer loss",
      "formula": "loss_i = draw_i * k * distance_i ; delivered_i = draw_i + loss_i",
      "note": "k is view.fit.transferLossPerUnit; distance is from the reactor core to the mounting bay."
    },
    {
      "id": "loop_balance",
      "label": "Coolant loop balance",
      "formula": "effectiveDiss_i = diss_i * (coolantPct/100) * (1 - k * distance_i) ; margin_i = effectiveDiss_i - heatGen_i",
      "note": "A negative node margin is a HOT SPOT."
    },
    {
      "id": "moduleScale",
      "label": "Module bus draw scale",
      "formula": "moduleScale = moduleDrawScale * (1 - bulkModuleDiscount * clamp((nModules - 1)/19, 0, 1))"
    },
    {
      "id": "powerUsedForgiving",
      "label": "Forgiving power budget",
      "formula": "powerUsed = reactor.parasiticDraw + Σ(module.powerDraw * moduleScale)"
    }
  ],
  "tradeoffs": [
    {
      "left": "Radiator area",
      "effect": "↓ heat, ↑ RCS, ↑ mass"
    },
    {
      "left": "RAM / stealth coating",
      "effect": "↓ RCS, ↑ mass, traps heat"
    },
    {
      "left": "Larger mana crystal S",
      "effect": "↑ power, ↑ instability, ↑ heat, ↑ resonance RCS"
    },
    {
      "left": "Active ECM",
      "effect": "↑ power draw, ↑ heat, ↑ self-emissions; passive EMCON is quiet but weak"
    },
    {
      "left": "Heavy armour",
      "effect": "↑ mass, ↑ inertia, ↑ heat retention; stealth shaping constrains limb geometry"
    },
    {
      "left": "Power deficit",
      "effect": "brownouts: abilities fail, HUD flicker"
    },
    {
      "left": "Heat saturation",
      "effect": "weapon derate, forced vent, meltdown"
    },
    {
      "left": "High RCS",
      "effect": "hostiles detect and lock faster"
    },
    {
      "left": "ECM jamming",
      "effect": "breaks locks but paints you as a target"
    },
    {
      "left": "Fit / transfer routing",
      "effect": "Longer bus + coolant runs ↑ transfer loss and heat; clustering hot parts near radiators ↓ loop loss but ↑ local RCS"
    },
    {
      "left": "Higher reactor output",
      "effect": "↑ power margin, ↓ brownout risk, ↑ heat to dissipate"
    },
    {
      "left": "Bulk module discount",
      "effect": "each extra module costs less bus power at full loadout"
    },
    {
      "left": "Maximum modules",
      "effect": "still costs mass / heat / RCS, but no longer forces BROWNOUT"
    }
  ],
  "note": " 0.1.7-test balance pass: reactor net output is much higher, module bus draw is scaled down and further discounted in bulk as the loadout fills, parasitic draw is reduced, and validation thresholds are relaxed. This is deliberately forgiving so players can fit the maximum number of modules and still have positive power margin."
}
