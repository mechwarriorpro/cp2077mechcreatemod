  "validationStates": [
    {
      "code": "BROWNOUT",
      "severity": "critical",
      "detail": "powerMargin < 0 — abilities fail, HUD flickers, weapon damage derates."
    },
    {
      "code": "THERMAL SATURATION",
      "severity": "critical",
      "detail": "Heat generation exceeds dissipation; weapons derate and vents open."
    },
    {
      "code": "OVER MASS",
      "severity": "warning",
      "detail": "Mass above reference budget — speed, dash and jump are penalised."
    },
    {
      "code": "COM OFFSET",
      "severity": "warning",
      "detail": "Centre of mass is outside the stability envelope; recoil drift and screen shake."
    },
    {
      "code": "STRUCTURAL STRESS",
      "severity": "warning",
      "detail": "Hardpoint and armour loading exceeds bracing capacity."
    },
    {
      "code": "RCS EXPOSURE",
      "severity": "warning",
      "detail": "High radar cross section — hostiles detect and lock faster."
    },
    {
      "code": "ECM SELF-DETECTION",
      "severity": "warning",
      "detail": "Jamming paints you as a target; self-emissions dominate the signature."
    },
    {
      "code": "MANA STARVATION",
      "severity": "warning",
      "detail": "Atmospheric harvest and growth pool cannot sustain the requested flow."
    },
    {
      "code": "LATTICE OVERFLOW",
      "severity": "critical",
      "detail": "Containment lattice is driven beyond its design flux."
    },
    {
      "code": "CRYSTAL RESONANCE",
      "severity": "warning",
      "detail": "Crystal size/flow resonance adds signature and surge risk."
    },
    {
      "code": "CONTAINMENT FAILURE",
      "severity": "critical",
      "detail": "Instability > threshold; surges, forced vent, meltdown / Protocol 3 eject."
    },
    {
      "code": "HARDPOINT OVERFLOW",
      "severity": "warning",
      "detail": "More hardpoints than the frame can brace."
    }
  ],
  "keyBindings": {
    "move": "W A S D",
    "aim": "Mouse",
    "fire": "LMB",
    "abilities": "Q / E / R",
    "dash": "Shift",
    "companion": "1 - 4",
    "pause": "P",
    "vent": "V"
  },
  "equations": [
    {
      "id": "powerUsed",
      "label": "Power budget",
      "formula": "powerUsed = Σ subsystem.powerDraw"
    },
    {
      "id": "powerMargin",
      "label": "Power margin",
      "formula": "powerMargin = reactor.netOutput - powerUsed   // <0 => BROWNOUT"
    },
    {
      "id": "totalMass",
      "label": "Total mass",
      "formula": "totalMass = frame.mass + Σ part.mass + payload"
    },
    {
      "id": "speed",
      "label": "Speed",
      "formula": "speed = baseSpeed * (1 - k1*totalMass/massRef) * (1 - k2*structuralStress)"
    },
    {
      "id": "heatGen",
      "label": "Heat generated",
      "formula": "heatGen = reactor.heat + Σ part.heatGen + movementHeat + ecmHeat"
    },
    {
      "id": "heatDiss",
      "label": "Heat dissipated",
      "formula": "heatDiss = Σ radiator.area * coolantFlow * efficiency"
    },
    {
      "id": "netHeat",
      "label": "Net heat",
      "formula": "netHeat = heatGen - heatDiss"
    },
    {
      "id": "temperature",
      "label": "Temperature",
      "formula": "temperature += netHeat * dt / thermalMass   // >1 => DERATE / VENT / MELTDOWN"
    },
    {
      "id": "rcs",
      "label": "Radar cross section",
      "formula": "rcs = shapeFactor(facets, torsoW, limbStance) * materialFactor(RAM, coating) + crystalSignature(S, η) + activeEmissions(jammer, radar, charge)"
    },
    {
      "id": "detectRange",
      "label": "Detection range",
      "formula": "detectRange = k * sqrt(rcs) * enemySensorFactor"
    },
    {
      "id": "jamStrength",
      "label": "Jam strength",
      "formula": "jamStrength = jammerPower * antennaGain / (dist^2 * enemyECCM)"
    },
    {
      "id": "lockBreak",
      "label": "Lock break",
      "formula": "lockBreak = clamp(jamStrength - enemyLockQuality, 0, 1)"
    },
    {
      "id": "selfEmissions",
      "label": "Self emissions",
      "formula": "selfEmissions = jammerPower * (LPI ? 0.25 : 1.0)   // jamming makes you visible"
    }
  ],
  "tradeoffs": [
    {
      "left": "Radiator area",
      "effect": "↓ heat, ↑ RCS, ↑ mass"
    },
    {
      "left": "RAM / stealth coating",
      "effect": "↓ RCS, ↑ mass, traps heat"
    },
    {
      "left": "Larger mana crystal S",
      "effect": "↑ power, ↑ instability, ↑ heat, ↑ resonance RCS"
    },
    {
      "left": "Active ECM",
      "effect": "↑ power draw, ↑ heat, ↑ self-emissions; passive EMCON is quiet but weak"
    },
    {
      "left": "Heavy armour",
      "effect": "↑ mass, ↑ inertia, ↑ heat retention; stealth shaping constrains limb geometry"
    },
    {
      "left": "Power deficit",
      "effect": "brownouts: abilities fail, HUD flicker"
    },
    {
      "left": "Heat saturation",
      "effect": "weapon derate, forced vent, meltdown"
    },
    {
      "left": "High RCS",
      "effect": "hostiles detect and lock faster"
    },
    {
      "left": "ECM jamming",
      "effect": "breaks locks but paints you as a target"
    }
  ]
}
