      "key": "power",
      "label": "Bus draw",
      "unit": "kW",
      "min": 0,
      "max": 80,
      "step": 1,
      "default": 8
    },
    {
      "key": "mass",
      "label": "Dry mass",
      "unit": "kg",
      "min": 0,
      "max": 900,
      "step": 10,
      "default": 120
    },
    {
      "key": "heat",
      "label": "Heat per volley",
      "unit": "kW",
      "min": 0,
      "max": 90,
      "step": 1,
      "default": 10
    },
    {
      "key": "damage",
      "label": "Damage / defence",
      "unit": "pts",
      "min": 0,
      "max": 400,
      "step": 5,
      "default": 60
    },
    {
      "key": "range",
      "label": "Effective range",
      "unit": "m",
      "min": 5,
      "max": 1500,
      "step": 5,
      "default": 300
