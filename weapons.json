  "consequences": {
    "power": "bus draw is discounted with the module bulk discount; a deficit causes BROWNOUT",
    "heat": "heat per volley * rate/60 feeds netHeat; saturation derates weapon damage",
    "rcs": "active emissions and large radiators raise detectRange",
    "ecm": "jamming breaks in-world locks but paints the mech as a target",
    "armor": "shield / plate rating adds destructible HP to the shield parts in MF.damage",
    "capacity": "0 = infinite energy charge; ballistic / missile weapons consume shots"
  },
  "disclaimer": "Procedural weapon parameters only. No meshes, projectiles, sounds, rigs, textures or base-mod / third-party assets are shipped."
