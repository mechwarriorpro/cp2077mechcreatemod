# ---------------------------------------------------------------------------
# 2. Forgiving energy / reactor balance (mirrors reactors.json + simulation.json).
# ---------------------------------------------------------------------------
Mechs.Mechfall_Balance:
  $type: MechfallBalanceRecord
  outputScale: 56.0
  derateFactor: 0.26
  heatLoadFactor: 0.80
  reactorParasiticScale: 0.62
  moduleDrawScale: 0.72
  bulkModuleDiscount: 0.42
  payloadPerHardpoint: 12.0
  brownoutMargin: -12.0
  hardpointLimit: 20
  maxModules: 24
  loadoutLimit: 8

# ---------------------------------------------------------------------------
# 3. Per-part destruction thresholds (mirrors damage.json).
# ---------------------------------------------------------------------------
Mechs.Mechfall_Damage:
  $type: MechfallDamageRecord
  cockpitDestruction: 0.70
  torsoDestruction: 0.90
  ejectKey: X
  fullDestructionMarksEveryPart: true
  despawnsEntities: true
  endsRun: true
  sections:
    - cockpit
    - torso
    - limb
    - system
    - weapon
    - shield

# ---------------------------------------------------------------------------
# 4. Example-only full-model policy (mirrors models.json).
# ---------------------------------------------------------------------------
Mechs.Mechfall_ModelPolicy:
  $type: MechfallModelPolicyRecord
  onlyExamplesAllowed: true
  allowedCount: 30
  rejectGenericHulls: true
  customDesignsMustUseExampleParts: true
  independentOrthographicViews: true
  ships3DMesh: true

# ---------------------------------------------------------------------------
# 5. Patch matrix (mirrors compat.json -> ingamePilot.gamePatches).
# ---------------------------------------------------------------------------
Mechs.Mechfall_PatchMatrix:
  $type: MechfallPatchMatrixRecord
  targetPatch: "2.31"
  game_2_3_cet: "1.36.0"
  game_2_31_cet: "1.37.1"
  game_2_31_red4ext: "1.29.0 / 1.30.0"
  game_2_5_cet: "1.38.1"
  note: "CET 1.38.x drops pre-2.5 game support. On 2.31 use CET 1.37.1."

# NOTE: These are ORIGINAL records. Nothing overrides a vanilla or base-mod
# record. Validate against CP2077 2.31 in-game before any real use.
