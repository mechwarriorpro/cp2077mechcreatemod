      "min": 1.0,
      "max": 5.0,
      "step": 1.0,
      "default": 2.0
    },
    {
      "key": "C",
      "label": "containment",
      "unit": "0-1",
      "min": 0.0,
      "max": 0.98,
      "step": 0.01,
      "default": 0.74
    },
    {
      "key": "W",
      "label": "coolantFlow",
      "unit": "flow",
      "min": 0.05,
      "max": 4.0,
      "step": 0.05,
      "default": 1.2
    },
    {
      "key": "L",
      "label": "filtration",
      "unit": "0-1",
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "default": 0.8
    }
  ],
  "model": {
    "sizeExponent": 0.85,
    "instabilitySizeExponent": 1.6,
    "instabilityFlowExponent": 1.2,
    "gradeBonus": 0.08,
    "derateFactor": 0.45,
    "S_ref": 1.0,
    "F_ref": 4.0,
    "heatLoadFactor": 1.0,
    "signatureFactor": 2.6,
    "resonanceFactor": 0.9,
    "equations": [
      "rawHarvest   = A * biomeMultiplier * L",
      "growthPool  += (G - F) * dt",
      "throughput   = min(F, growthPool + rawHarvest)",
      "grossMana    = throughput * eta * (S^sizeExponent) * (1 + gradeBonus*(Q-1))",
      "grossOutput  = grossMana * outputScale        // mana/s -> kW unit conversion",
      "heatLoad     = (throughput/W) * eta * (1-eta) * heatLoadFactor * (1+gradeBonus*(Q-1))  // flow duty, size-independent",
      "instability  = (S/S_ref)^1.6 * (F/F_ref)^1.2 * (1-eta) * (1-C) * (1+heatLoad)",
      "netOutput    = grossOutput * (1 - min(instability,1)*derateFactor)",
      "meltdown     = instability > 1.0"
    ],
    "note": "outputScale converts mana throughput to kW so the reactor can feed kW-scale subsystem draws. heatLoad is the size-independent flow/regulator duty, so doubling S gives 2^sizeExponent ~1.8x GROSS power and 2^instabilitySizeExponent ~3x instability exactly; netOutput after the derate is lower. All exponents live here and in simulation.json.",
    "outputScale": 34.0
  },
