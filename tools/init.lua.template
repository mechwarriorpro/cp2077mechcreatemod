-- Lookup helpers -----------------------------------------------------------
local function clamp(v, a, b) if v < a then return a end if v > b then return b end return v end
local function f(v, d) return string.format("%." .. (d or 1) .. "f", v or 0) end
local function log(msg)
  table.insert(MF.log, 1, tostring(msg))
  while #MF.log > 20 do table.remove(MF.log) end
  print("[MECHFALL] " .. tostring(msg))
end
MF.logMsg = log

local function reactorById(id)
  for _, p in ipairs(MF_DATA.reactors or {}) do
    if p.id == id then return p end
  end
  return (MF_DATA.reactors or {})[1]
end

local function designById(id)
  for _, d in ipairs(MF.customDesigns) do if d.id == id then return d end end
  for _, c in ipairs(MF_DATA.roster or {}) do
    if c.id == id then
      return {
        id = c.id, name = c.name, origin = "prefab", faction = c.faction,
        archetype = c.archetype, role = c.role, shape = c.shape,
        reactor = c.reactorId, subsystemIds = c.subsystems, hardpoints = c.hardpoints
      }
    end
  end
  return MF.customDesigns[1]
end
MF.designById = designById

-- Built-in subsystem templates: six attributes derived from JSON params -----
MF.subsystems = {}
local SIX = { "powerDraw", "mass", "heatGen", "heatDiss", "rcs", "ecm" }
local function sixZero() return { powerDraw = 0, mass = 0, heatGen = 0, heatDiss = 0, rcs = 0, ecm = 0 } end

local function derive(s)
  if s.six then return s.six end
  local p = s.params or {}
  local o = sixZero()
  local n = function(k, d) return tonumber(p[k]) or d or 0 end
  local c = s.category
  if c == "power_bus" then
    local cap, gauge, volts, red, bank, ground = n("busCapacity", 180), n("conduitGauge", 8),
      n("voltage", 120), n("routingRedundancy", 1), n("capacitorBank", 24), n("grounding", 0.7)
    local loss = clamp(0.15 - gauge * 0.004 - volts / 6000 + (1 - ground) * 0.06, 0.012, 0.34)
    o.powerDraw = 2 + cap * 0.012 + red * 1.4 + bank * 0.03
    o.mass = 24 + cap * 0.22 + gauge * 2.2 + bank * 0.8 + red * 6
    o.heatGen = cap * loss * 0.06 + red * 0.4
    o.heatDiss = 1.5 + gauge * 0.2
    o.rcs = 0.4 + cap * 0.002
    o.ecm = ground * 1.5
  elseif c == "thermal_loop" then
    local ct = ({ 0.75, 1.0, 1.32, 1.55 })[clamp(math.floor(n("coolantType", 1)) + 1, 1, 4)]
    local pump, area, pipes, phase = n("pumpRate", 48), n("radiatorArea", 38), n("heatPipeCount", 14), n("phaseChangeMass", 18)
    local ins = n("insulation", 0.3)
    o.powerDraw = 1 + pump * 0.08 + pipes * 0.05
    o.mass = 18 + area * 1.6 + pipes * 0.7 + phase * 0.9
    o.heatGen = pump * 0.05
    o.heatDiss = (area * 0.58 + pipes * 0.4) * ct * (0.4 + pump / 50) * (1 - ins * 0.35)
    o.rcs = area * 0.062 + (1 - ins) * 0.3
  elseif c == "mass_structure" then
    local arm, cw, hp, off, brace = n("armourDensity", 1.1), n("counterweights", 12),
      n("hardpoints", 4), n("comOffset", 0), n("bracing", 0.55)
    o.mass = arm * 150 + cw + hp * 12 + brace * 40
    o.heatGen = arm * 1.2
    o.heatDiss = -arm * 5.5
    o.rcs = arm * 1.4 + hp * 0.35 + (1 - brace) * 0.3
    local mat = ({ 1.0, 1.28, 0.78, 1.62, 0.7 })[clamp(math.floor(n("frameMaterial", 1)) + 1, 1, 5)]
    o.extra = { comOffset = off - cw / 260,
      stress = clamp((arm * 0.48 + hp / 22) / (0.32 + brace * 1.25), 0, 1.6),
      mat = mat, armourDensity = arm }
  elseif c == "signature_rcs" then
    local facet, ram, edge, cav, emit, gaps = n("facetAngle", 24), n("ramCoating", 0.4),
      n("edgeAlignment", 0.5), n("cavityShielding", 0.35), n("emitterPlacement", 0.5), n("panelGaps", 0.2)
    local mult = clamp(1.35 - facet / 60 * 0.5 - ram * 0.55 - edge * 0.2 - cav * 0.2 - emit * 0.15 + gaps * 0.3, 0.12, 1.6)
    o.powerDraw = 0.5 + ram * 2
    o.mass = 18 + ram * 140 + cav * 35 + edge * 12
    o.heatGen = ram * 2
    o.heatDiss = -ram * 7
    o.rcs = -(1 - mult) * 11
    o.ecm = cav
    o.extra = { rcsMultiplier = mult }
  elseif c == "ecm_ew" then
    local jam, gain, band, decoys, lpi, eccm = n("jammerPower", 28), n("antennaGain", 5),
      n("bandCoverage", 0.6), n("decoyCount", 4), n("lpiMode", 0), n("eccmResistance", 0.4)
    local chaff, spoof, emcon = n("chaff", 2), n("spoofing", 0.3), n("emcon", 0)
    local jamBase = jam * (0.4 + gain / 8) * (0.4 + band) * (lpi > 0 and 0.55 or 1) * (emcon > 0 and 0.08 or 1)
    local emissions = jam * (lpi > 0 and 0.25 or 1) * (emcon > 0 and 0.05 or 1) + spoof * 8 + chaff * 0.2
    o.powerDraw = 3 + jam * 0.85 + band * 8 + spoof * 6 - (emcon > 0 and 2 or 0)
    o.mass = 16 + jam * 0.35 + decoys * 3 + chaff * 1.2 + gain * 2
    o.heatGen = jam * 0.28 + spoof * 3
    o.rcs = 0.6 + gain * 0.12  -- antenna hardware only; emissions added once in compute()
    o.ecm = jamBase * 0.35 + decoys * 0.5 + eccm * 8 + chaff * 0.3
    o.extra = { emissions = emissions, jamBase = jamBase, eccm = eccm }
  elseif c == "sensors_os" then
    local ap, opt, passive, solver, ai = n("radarAperture", 2.4), n("opticalGrade", 2),
      n("passiveMode", 0), n("targetingSolver", 2), n("aiAssist", 0.4)
    o.powerDraw = 2 + ap * 2.2 * (passive > 0 and 0 or 1) + solver * 2 + ai * 4
    o.mass = 12 + ap * 6 + opt * 3 + solver * 1.5
    o.heatGen = ap * 0.8 * (passive > 0 and 0 or 1) + solver * 0.7
    o.rcs = passive > 0 and 0 or ap * 0.6
    o.ecm = solver * 1.6
  elseif c == "actuators" then
    local servos, myo, damp, joint = n("servoCount", 10), n("myomerLayers", 5),
      n("damperStiffness", 0.5), n("jointRange", 0.9)
    o.powerDraw = 3 + servos * 0.9 + myo * 0.6
    o.mass = 24 + servos * 3.5 + myo * 4 + damp * 20
    o.heatGen = servos * 0.35 + myo * 0.2
    o.heatDiss = 1 + damp * 2
    o.rcs = joint * 0.6
    o.extra = { speed = clamp(0.55 + servos / 28 + myo / 22, 0.2, 2.4) }
  elseif c == "freeform" then
    for _, k in ipairs(SIX) do o[k] = n(k, 0) end
  end
  return o
end
MF.derive = derive

for _, t in ipairs(MF_DATA.subsystemTemplates or {}) do
