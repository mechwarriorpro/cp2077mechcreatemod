-- own procedural autopilot / procedural coating.
MF.compat = {
  coat = {}, code = "", autopilot = false, autopilotLink = false,
  autodriveMod = nil, autodriveName = nil,
  crystalCoatMod = nil, crystalCoatName = nil,
  lastProbe = "not probed"
}
