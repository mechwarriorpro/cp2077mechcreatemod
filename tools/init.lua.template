    if ImGui.Button("HIT##dc" .. tostring(q.id)) then IG.hitPart(q.id, 0.10) end
    ImGui.SameLine()
    if ImGui.Button("KILL##dc" .. tostring(q.id)) then IG.destroyPart(q.id) end
  end
  ImGui.EndChild()
end

registerForEvent("onInit", function()
  MF.visible = false
  log("MECHFALL // FORGE 77 loaded · " .. tostring(#(MF_DATA.roster or {})) .. " prefabs, " ..
    tostring(#MF.subsystems) .. " subsystem templates")
  log("Open the overlay with the CET hotkey binding: MECHFALL // FORGE 77")
  log("Target CP2077 patch " .. tostring((MF_DATA.compat or {}).ingamePilot and
    MF_DATA.compat.ingamePilot.targetPatch or "2.31") ..
    " · needs CET 1.37.1 + RED4ext 1.29/1.30 (NOT CET 1.38.x) · Phantom Liberty optional")
  log("FULL MODELS: " .. tostring((MF_DATA.models or {}).allowedCount or 30) ..
    " example-only full models / traces · onlyExamplesAllowed=" ..
    tostring((MF_DATA.models or {}).onlyExamplesAllowed))
  pcall(MF.compatProbe)
  pcall(function()
    MF.ingame.probe()
    log("In-game pilot: " .. MF.ingame.spawner ..
      " · deploy with F6 / hotkey or the IN-GAME PILOT tab")
  end)
end)

registerForEvent("onDraw", function()
  if not MF.visible then return end
  if not ImGui.Begin("MECHFALL // FORGE 77 · CET TEST UI") then ImGui.End(); return end
  for i, name in ipairs(MF.tabs) do
    if ImGui.Button(name .. "##tab" .. i) then MF.tab = i end
    if i < #MF.tabs then ImGui.SameLine() end
  end
  ImGui.Separator()
  local ok, t = pcall(MF.compute, MF.activeDesignId)
  if not ok then
    ImGui.Text("Telemetry error: " .. tostring(t))
    ImGui.End()
    return
  end
  if MF.tab == 1 then drawHangar(t)
  elseif MF.tab == 2 then drawSystems(t)
  elseif MF.tab == 3 then drawForge(t)
  elseif MF.tab == 4 then drawReactor(t)
  elseif MF.tab == 5 then drawWeaponForge(t)
  elseif MF.tab == 6 then drawModelLibrary(t)
  elseif MF.tab == 7 then drawDamageControl(t)
  elseif MF.tab == 8 then drawSettings()
  elseif MF.tab == 9 then drawCompat()
  else drawIngame(t) end
  ImGui.End()
end)

-- Hotkey registration: supported by modern CET; wrapped so older builds still load.
pcall(function()
  registerHotkey("mechfall_forge_toggle", "MECHFALL // FORGE 77", function()
    MF.visible = not MF.visible
    log("Overlay " .. (MF.visible and "opened" or "closed"))
  end)
end)

return MF
