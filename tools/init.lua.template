-- Reactor model (same equations as the browser) -----------------------------
MF.reactor = {
  F = 4.0, G = 5.2, A = 4.0, eta = 0.72, S = 1.0, Q = 2.0, C = 0.74, W = 1.2, L = 0.8
}
local function reactorModel(p)
  local m = MF.rcoeffs
  local rawHarvest = p.A * MF.biomeMultiplier * p.L
  local pool = math.max(0, (p.G - p.F) * 5 + rawHarvest)
  local throughput = clamp(math.min(p.F, pool + rawHarvest), 0, p.F)
  local grossMana = throughput * p.eta * (p.S ^ m.sizeExponent) * (1 + m.gradeBonus * (p.Q - 1))
  local gross = grossMana * m.outputScale
  local heatLoad = (throughput / math.max(p.W, 0.05)) * p.eta * (1 - p.eta) * m.heatLoadFactor
    * (1 + m.gradeBonus * (p.Q - 1))
  local instability = (p.S / m.S_ref) ^ m.instabilitySizeExponent * (p.F / m.F_ref) ^ m.instabilityFlowExponent
    * (1 - p.eta) * (1 - p.C) * (1 + heatLoad)
  local net = gross * (1 - math.min(instability, 1) * m.derateFactor)
  local crystalSig = m.signatureFactor * (p.S ^ (m.instabilitySizeExponent * 0.75)) * (1 - p.eta * 0.45)
  return { netOutput = net, grossOutput = gross, instability = instability, heatLoad = heatLoad,
    heat = gross * (1 - p.eta) * 0.12 + heatLoad * 8 + instability * 5,
    crystalSignature = crystalSig, rawHarvest = rawHarvest, meltdown = instability > 1.0 }
end
MF.reactorModel = reactorModel

-- Full design telemetry -----------------------------------------------------
function MF.compute(designId)
  local d = designById(designId or MF.activeDesignId) or MF.customDesigns[1]
  local r = reactorModel(MF.reactor)
  local parasitic = 3.5 + r.netOutput * 0.045 + (MF.reactor.W or 1.2) * 1.6 + (MF.reactor.C or 0.74) * 2
  local used, mass, hg, hd, rcs, ecm = parasitic, 0, r.heat, 0, r.crystalSignature, 0
  local comOffset, stress, jamBase, emissions, speedBoost = 0, 0.3, 0, 0, 1
  local rcsMult, ewHeat, transmissionLoss, thermalExtra, mat, arm = 1, 0, 0.08, 0, 1.28, 1.1
  for _, id in ipairs(d.subsystemIds or {}) do
    local s = subById(id)
    if s then
      local x = derive(s)
      used = used + (x.powerDraw or 0)
      mass = mass + (x.mass or 0)
      hg = hg + (x.heatGen or 0)
      hd = hd + (x.heatDiss or 0)
      rcs = rcs + (x.rcs or 0)
      ecm = ecm + (x.ecm or 0)
      if s.category == "ecm_ew" then ewHeat = x.heatGen or 0 end
      if s.category == "thermal_loop" then
        local pp = s.params or {}
        thermalExtra = 60 + (tonumber(pp.phaseChangeMass) or 18) * 4 + (tonumber(pp.insulation) or 0.3) * 30
      end
      if s.category == "power_bus" then
        local pp = s.params or {}
        local gauge, volts, ground = tonumber(pp.conduitGauge) or 8, tonumber(pp.voltage) or 120, tonumber(pp.grounding) or 0.7
        transmissionLoss = clamp(0.15 - gauge * 0.004 - volts / 6000 + (1 - ground) * 0.06, 0.012, 0.34)
      end
      if x.extra then
        comOffset = comOffset + (x.extra.comOffset or 0)
        stress = math.max(stress, x.extra.stress or 0)
        jamBase = jamBase + (x.extra.jamBase or 0)
        emissions = emissions + (x.extra.emissions or 0)
        speedBoost = speedBoost * (x.extra.speed or 1)
        rcsMult = x.extra.rcsMultiplier or rcsMult
        mat = x.extra.mat or mat
        arm = x.extra.armourDensity or arm
      end
    end
  end
  local shape = d.shape or {}
  local sf = ({ angular = 1.0, rounded = 0.94, knight = 1.18, spider = 1.28, tetrapod = 1.34 })[shape.style] or 1.0
  local shapeVolume = ((shape.torsoW or 2.4) * (shape.torsoH or 2.8) * (shape.torsoD or 1.7) * 0.32
    + (shape.shoulderW or 2.2) * (shape.shoulderH or 0.8) * 0.7
    + ((shape.upperArm or 1.5) + (shape.foreArm or 1.7)) * 0.28
    + ((shape.upperLeg or 1.9) + (shape.lowerLeg or 2.0)) * 0.34
    + (shape.hipW or 1.7) * 0.4 + (shape.footL or 1.3) * 0.25
    + (shape.armorFlare or 0.5) * 0.5) * sf
  local frameMass = shapeVolume * (MF.coeffs.shapeMassFactor or 75) * mat * (0.6 + arm * 0.4)
  -- The reactor is a subsystem too: add its mass, cooling and damping contribution.
  mass = mass + (120 + (MF.reactor.S or 1) * 95 + (MF.reactor.C or 0.74) * 60 + (MF.reactor.Q or 2) * 8)
  hd = hd + (2 + (MF.reactor.W or 1.2) * 6)
  ecm = ecm + (0.4 + (1 - (MF.reactor.C or 0.74)) * 2)
  local totalMass = frameMass + mass + frameMass * 0.22 + (d.hardpoints or 6) * 18
  local usedEff = used * (1 + transmissionLoss)
  local powerMargin = r.netOutput - usedEff
  hg = hg + ewHeat * 0.35
  local heatDiss = math.max(0, hd)
  local netHeat = hg - heatDiss
  local thermalMass = 140 + totalMass * (MF.coeffs.thermalMassFactor or 6) / 12 + thermalExtra
  local temp = clamp(0.32 + netHeat / math.max(heatDiss, 6) * 0.42, 0, 1.8)
  local shapeFactor = (((shape.torsoW or 2.4) * 0.8 + (shape.legStance or 1.3) * 0.7
    + (shape.shoulderW or 2.2) * 0.5 + (shape.armorFlare or 0.5) * 0.4 + 1)
    ^ (MF.coeffs.rcsShapeExponent or 1.35)) * 0.35 + 1.2
  local materialFactor = rcsMult ^ (MF.coeffs.rcsMaterialExponent or 0.85)
  local frontRcs = clamp((shapeFactor * materialFactor + rcs
    + emissions * (MF.coeffs.emissionRcsFactor or 0.12)) * 0.78, 0.35, 500)
  local detect = (MF.coeffs.detectionK or 120) * (frontRcs ^ (MF.coeffs.detectionExponent or 0.5))
    * (MF.coeffs.enemySensorFactor or 1)
  local jam = (MF.coeffs.jamK or 240) / 100 * jamBase / 1.5
  local speed = math.max(0.8, (MF.coeffs.baseSpeed or 9) *
    (1 - (MF.coeffs.k1 or 0.34) * totalMass / (MF.coeffs.massRef or 2200)) *
    (1 - (MF.coeffs.k2 or 0.25) * stress) * speedBoost)
  comOffset = comOffset + ((shape.weaponX or 1.5) - (shape.torsoW or 2.4)) * 0.015
  local validation = {}
  if powerMargin < 0 then table.insert(validation, "BROWNOUT") end
  if netHeat > 0 and temp > 0.72 then table.insert(validation, "THERMAL SATURATION") end
  if totalMass / (MF.coeffs.massRef or 2200) > 1.35 then table.insert(validation, "OVER MASS") end
  if math.abs(comOffset) > 0.34 then table.insert(validation, "COM OFFSET") end
  if stress > 0.78 then table.insert(validation, "STRUCTURAL STRESS") end
  if frontRcs > 14 then table.insert(validation, "RCS EXPOSURE") end
  if emissions > 22 then table.insert(validation, "ECM SELF-DETECTION") end
  if r.rawHarvest < 0.22 * math.max(MF.reactor.F, 0.01) then table.insert(validation, "MANA STARVATION") end
  if r.instability > 0.55 then table.insert(validation, "CRYSTAL RESONANCE") end
  if r.instability > 0.95 then table.insert(validation, "CONTAINMENT FAILURE") end
  if r.meltdown then table.insert(validation, "MELTDOWN / PROTOCOL 3") end
  return {
    design = d, reactor = r, powerUsed = usedEff, powerMargin = powerMargin,
    totalMass = totalMass, frameMass = frameMass, netHeat = netHeat, heatGen = hg,
    heatDiss = heatDiss, temperature = temp, thermalMass = thermalMass,
    rcsFront = frontRcs, detectRange = detect, jamStrength = jam,
    selfEmissions = emissions, ecm = ecm, speed = speed, comOffset = comOffset,
    stress = stress, validation = validation
  }
end

-- Optional base-mod hooks: pcall-wrapped, user-triggered, NEVER required ----
function MF.optionalLinkShard()
  local ok, err = pcall(function()
    if Game and Game.AddToInventory then Game.AddToInventory("Items.BT7274_LinkShard", 1) end
  end)
  log("Optional link shard: " .. (ok and "done" or ("unavailable (" .. tostring(err) .. ")")))
end
function MF.optionalRestartQuest()
  local ok, err = pcall(function()
    local m = GetMod and GetMod("bt_quest") or nil
    if m and m.Restart then m.Restart() end
  end)
  log("Optional quest restart: " .. (ok and "done" or ("unavailable (" .. tostring(err) .. ")")))
end
function MF.optionalTitanPoints()
  local ok, err = pcall(function()
    local m = GetMod and GetMod("bt_skill_trees") or nil
    if m and m.TitanPoints then m.TitanPoints(5) end
  end)
  log("Optional TITAN points: " .. (ok and "done" or ("unavailable (" .. tostring(err) .. ")")))
end

-- ImGui helpers -------------------------------------------------------------
local function bar(label, value, max, unit)
  local m = math.max(max or 1, 0.0001)
  ImGui.Text(label .. ": " .. f(value, 2) .. " " .. (unit or ""))
  ImGui.ProgressBar(clamp(value / m, 0, 1), -1, 22)
end
local function textWrapped(s) ImGui.TextWrapped(s) end

local function drawHangar(t)
  ImGui.Text("PREFAB / TEARDOWN LIBRARY · UNLOCK ALL (TEST MODE): " .. (MF.unlockAll and "ON" or "OFF"))
  ImGui.Separator()
  ImGui.BeginChild("mf_hangar_list", 250, 260)
  for i, c in ipairs(MF_DATA.roster or {}) do
    if ImGui.Selectable(c.name .. "##" .. i, MF.rosterIndex == i) then
      MF.rosterIndex = i
      MF.activeDesignId = c.id
      MF.reactorPresetIndex = 1
      for j, p in ipairs(MF_DATA.reactors or {}) do
        if p.id == c.reactorId then MF.reactorPresetIndex = j end
      end
      log("Selected " .. c.name .. " (" .. c.faction .. ")")
    end
  end
  for i, d in ipairs(MF.customDesigns) do
    if ImGui.Selectable("[CUSTOM] " .. d.name .. "##c" .. i, MF.activeDesignId == d.id) then
      MF.activeDesignId = d.id
      log("Selected custom design " .. d.name)
    end
  end
  ImGui.EndChild()
  ImGui.SameLine()
  ImGui.BeginChild("mf_hangar_detail", 380, 260)
  local d = t.design
  ImGui.Text(d.name or "?")
  ImGui.Text("Faction: " .. tostring(d.faction) .. " · " .. tostring(d.archetype or "custom"))
  textWrapped("Role: " .. tostring(d.role or "Player-authored frame"))
  ImGui.Separator()
  bar("POWER MARGIN", t.powerMargin, 120, "kW")
  bar("TOTAL MASS", t.totalMass, 2600, "kg")
  bar("NET HEAT", t.netHeat, 80, "kW")
  bar("FRONT RCS", t.rcsFront, 40, "m2")
  bar("ECM / JAM", t.jamStrength, 80, "str")
  ImGui.Separator()
  ImGui.Text("VALIDATION: " .. (#t.validation == 0 and "NOMINAL" or table.concat(t.validation, ", ")))
  if ImGui.Button("SET ACTIVE") then log("Active design: " .. tostring(d.name)) end
  ImGui.SameLine()
  if ImGui.Button("OPTIONAL: LINK SHARD") then MF.optionalLinkShard() end
  ImGui.EndChild()
end

local function sliderParam(s, key, label, min, max, step)
  local v = { tonumber(s.params[key]) or min }
  local nv, changed = ImGui.SliderFloat(label .. "##" .. s.id .. key, v[1], min, max, "%.2f")
  if changed then s.params[key] = nv; s.six = nil; s.six = derive(s) end
end

local function drawSystems(t)
  ImGui.BeginChild("mf_sub_list", 250, 300)
  for i, s in ipairs(MF.subsystems) do
    if ImGui.Selectable(s.name .. "##" .. i, MF.subIndex == i) then MF.subIndex = i end
  end
  ImGui.EndChild()
  ImGui.SameLine()
  ImGui.BeginChild("mf_sub_edit", 380, 300)
  local s = MF.subsystems[MF.subIndex] or MF.subsystems[1]
  if s then
    ImGui.Text("AUTHORING: " .. s.name .. " (" .. s.category .. ")")
    local x = derive(s)
    ImGui.Text("P " .. f(x.powerDraw) .. "  M " .. f(x.mass) .. "  HG " .. f(x.heatGen))
    ImGui.Text("HD " .. f(x.heatDiss) .. "  RCS " .. f(x.rcs) .. "  ECM " .. f(x.ecm))
    ImGui.Separator()
    local params = {
      { "busCapacity", 0, 600 }, { "radiatorArea", 0, 160 }, { "armourDensity", 0, 3 },
      { "ramCoating", 0, 1 }, { "jammerPower", 0, 200 }, { "radarAperture", 0, 12 },
      { "servoCount", 0, 40 }, { "powerDraw", -100, 100 }, { "mass", -500, 1500 },
      { "heatGen", 0, 200 }, { "heatDiss", 0, 200 }, { "rcs", -40, 60 }, { "ecm", -40, 80 }
    }
    for _, q in ipairs(params) do
      if s.params[q[1]] ~= nil then sliderParam(s, q[1], q[1], q[2], q[3]) end
    end
    ImGui.Separator()
    local installed = false
    for _, id in ipairs(t.design.subsystemIds or {}) do if id == s.id then installed = true end end
    local val, ch = ImGui.Checkbox("INSTALLED IN ACTIVE DESIGN", installed)
    if ch then
      local ids = t.design.subsystemIds or {}
      if val then
        table.insert(ids, s.id)
      else
        for i = #ids, 1, -1 do if ids[i] == s.id then table.remove(ids, i) end end
      end
      t.design.subsystemIds = ids
      log((val and "Installed " or "Removed ") .. s.name)
    end
    if ImGui.Button("CREATE NEW BLANK SUBSYSTEM") then
      local ns = { id = "cet_sub_" .. tostring(os.time()) .. tostring(#MF.subsystems),
        name = "NEW CET SUBSYSTEM", category = "freeform", custom = true, params = {}, six = sixZero() }
      for _, k in ipairs(SIX) do ns.params[k] = 0 end
      table.insert(MF.subsystems, ns)
      MF.subIndex = #MF.subsystems
      log("Created blank-slate subsystem (six attributes are directly editable)")
    end
    ImGui.SameLine()
    if ImGui.Button("PRINT CET LUA SNIPPET") then
      print("[MECHFALL] -- snippet for MF.customDesigns[...].subsystems")
      print("[MECHFALL] { id = \"" .. s.id .. "\", name = \"" .. s.name .. "\", category = \"" ..
        s.category .. "\", six = { powerDraw = " .. f(x.powerDraw, 3) .. ", mass = " .. f(x.mass, 3) ..
        ", heatGen = " .. f(x.heatGen, 3) .. ", heatDiss = " .. f(x.heatDiss, 3) ..
        ", rcs = " .. f(x.rcs, 3) .. ", ecm = " .. f(x.ecm, 3) .. " } }")
    end
  end
  ImGui.EndChild()
  ImGui.Separator()
  bar("POWER MARGIN", t.powerMargin, 120, "kW")
  bar("HEAT DISSIPATION", t.heatDiss, 120, "kW")
  bar("ECM STRENGTH", t.jamStrength, 80, "str")
end

local function drawForge(t)
  local d = t.design
  ImGui.Text("MECH FORGE · parametric shape (browser owns the visual modeling table)")
  ImGui.Separator()
  local shape = d.shape or {}
  local keys = { "torsoW", "torsoH", "torsoD", "headScale", "shoulderW", "shoulderH",
    "upperArm", "foreArm", "upperLeg", "lowerLeg", "hipW", "footL", "weaponX",
    "weaponY", "legStance", "armorFlare", "jetCount" }
  for _, k in ipairs(keys) do
    local min, max = 0.2, 4.6
    if k == "jetCount" then min, max = 0, 8 end
    if k == "armorFlare" then min, max = 0, 1.8 end
    if k == "headScale" then min, max = 0.2, 1.6 end
    local v = { tonumber(shape[k]) or min }
    local nv, changed = ImGui.SliderFloat(k .. "##shape", v[1], min, max, "%.2f")
    if changed then shape[k] = nv end
  end
  d.shape = shape
  if ImGui.Button("BAKE SHAPE INTO CUSTOM DESIGN") then
    local c = MF.customDesigns[1]
    c.shape = {}
    for k, v in pairs(shape) do c.shape[k] = v end
    MF.activeDesignId = c.id
    log("Baked shape into " .. c.name)
  end
  ImGui.SameLine()
  if ImGui.Button("SEND REACTOR TO FORGE") then log("Reactor parameters applied to active design") end
  ImGui.Separator()
  ImGui.Text("SPEED " .. f(t.speed, 2) .. " m/s · MASS " .. f(t.totalMass, 0) .. " kg")
  ImGui.Text("CoM " .. f(t.comOffset, 3) .. " · STRESS " .. f(t.stress, 2))
  ImGui.Text("VALIDATION: " .. (#t.validation == 0 and "NOMINAL" or table.concat(t.validation, ", ")))
end

local function drawReactor(t)
  ImGui.Text("MANA REACTOR · power source, one subsystem among many")
  local r = MF.reactor
  local sliders = {
    { "F", 0, 12 }, { "G", 0, 12 }, { "A", 0, 12 }, { "eta", 0.05, 0.99 },
    { "S", 0.2, 3.2 }, { "Q", 1, 5 }, { "C", 0, 0.98 }, { "W", 0.05, 4 }, { "L", 0, 1 }
  }
  for _, q in ipairs(sliders) do
    local v = { tonumber(r[q[1]]) or q[2] }
    local nv, changed = ImGui.SliderFloat(q[1] .. "##rx", v[1], q[2], q[3], "%.2f")
    if changed then r[q[1]] = nv end
  end
  ImGui.Separator()
  local pr = MF_DATA.reactors or {}
  if #pr > 0 then
    local names = {}
    for j, p in ipairs(pr) do names[j] = p.name end
    local idx, ch = ImGui.Combo("PRESET##rx", MF.reactorPresetIndex - 1, names, #pr)
    if ch then
      MF.reactorPresetIndex = idx + 1
      local p = pr[MF.reactorPresetIndex].params
      for k, v in pairs(p) do r[k] = v end
      log("Reactor preset: " .. pr[MF.reactorPresetIndex].name)
    end
  end
  local rm = reactorModel(r)
  bar("NET OUTPUT", rm.netOutput, 250, "kW")
  bar("INSTABILITY", rm.instability, 1.5, "")
  bar("HEAT LOAD", rm.heatLoad, 60, "kW")
  ImGui.Text("Crystal signature " .. f(rm.crystalSignature, 2) .. " m2 · doubling S = " ..
    f(2 ^ MF.rcoeffs.sizeExponent, 2) .. "x power / " ..
    f(2 ^ MF.rcoeffs.instabilitySizeExponent, 2) .. "x instability")
  if rm.meltdown then ImGui.TextColored(1, 0.3, 0.3, 1, "CONTAINMENT FAILURE / MELTDOWN") end
end

local function drawSettings()
  ImGui.Text("CONFIG · exponents are never hard-coded")
  local v, ch = ImGui.Checkbox("TEST MODE (deploy with penalties)", MF.testMode)
  if ch then MF.testMode = v end
  v, ch = ImGui.Checkbox("UNLOCK ALL (TEST MODE)", MF.unlockAll)
  if ch then MF.unlockAll = v end
  v, ch = ImGui.Checkbox("ALLOW INVALID DEPLOY", MF.allowInvalidDeploy)
  if ch then MF.allowInvalidDeploy = v end
  ImGui.Separator()
  for _, k in ipairs({ "k1", "k2", "massRef", "baseSpeed", "rcsShapeExponent",
    "rcsMaterialExponent", "detectionK", "jamK", "ecmFalloffExponent", "enemySensorFactor" }) do
    local val = { tonumber(MF.coeffs[k]) or 1 }
    local lo, hi = 0, 400
    if k == "k1" or k == "k2" then lo, hi = 0, 1 end
    if k == "rcsShapeExponent" then lo, hi = 0.5, 3 end
    if k == "ecmFalloffExponent" then lo, hi = 1, 3.5 end
    local nv, c = ImGui.SliderFloat(k .. "##co", val[1], lo, hi, "%.2f")
    if c then MF.coeffs[k] = nv end
  end
  ImGui.Separator()
  ImGui.Text("OPTIONAL BASE-MOD HOOKS (pcall-wrapped, never required)")
  if ImGui.Button("RESTART BT QUEST") then MF.optionalRestartQuest() end
  ImGui.SameLine()
  if ImGui.Button("TITAN POINTS +5") then MF.optionalTitanPoints() end
  ImGui.Separator()
  textWrapped("Browser prototype + CET UI is testable. A full 3D pilotable-mech release needs meshes, " ..
    "rigs, animations, VO, the game itself and private base-mod APIs. No base-mod files are bundled.")
  ImGui.Separator()
  ImGui.Text("EVENT LOG")
  ImGui.BeginChild("mf_log", -1, 90)
  for _, line in ipairs(MF.log) do ImGui.Text(line) end
  ImGui.EndChild()
end

local function drawCompat()
  ImGui.Text("OPTIONAL COMPATIBILITY · AUTODRIVE + CRYSTAL COAT")
  ImGui.Separator()
  ImGui.Text("AutoDrive: " .. tostring(MF.compat.autodriveName or "not detected — procedural autopilot"))
  ImGui.Text("Crystal Coat: " .. tostring(MF.compat.crystalCoatName or "not detected — procedural coat"))
  ImGui.Text("Vanilla Auto Drive is CP2077 2.3 (V key); CrystalCoat is 2.2+ (hold Y).")
  local v, ch = ImGui.Checkbox("AUTODRIVE LINK (state only)", MF.compat.autopilot)
  if ch then MF.compat.autopilot = v end
  if ImGui.Button("PROBE GetMod") then MF.compatProbe() end
  ImGui.SameLine()
  if ImGui.Button("HANDOFF WAYPOINT") then MF.compatHandoffWaypoint(40, 10) end
  ImGui.SameLine()
  if ImGui.Button("SYNC CRYSTAL COAT") then MF.compatSyncCrystalCoat() end
  ImGui.Separator()
  ImGui.Text("PROCEDURAL CRYSTAL COAT (primary / secondary / light hue / aspect)")
  for _, k in ipairs({ "metallic", "roughness", "flake", "wear", "emission", "lightsBrightness" }) do
    local val = { tonumber(MF.compat.coat[k]) or 0 }
    local nv, c = ImGui.SliderFloat(k .. "##cc", val[1], 0, 1, "%.2f")
    if c then MF.compat.coat[k] = nv end
  end
  local hue = { tonumber(MF.compat.coat.lightHue) or 0 }
  local nh, hc = ImGui.SliderFloat("lightHue##cc", hue[1], 0, 359, "%.0f")
  if hc then MF.compat.coat.lightHue = nh end
  local names, coats = {}, (MF_DATA.compat or {}).coatings or {}
  for i, p in ipairs(coats) do names[i] = p.name end
  local idx, cc = ImGui.Combo("COAT PRESET##cc", MF.compatPresetIndex - 1, names, #names)
  if cc then
    MF.compatPresetIndex = idx + 1
    local p = coats[MF.compatPresetIndex]
    if p then
      for k, val in pairs(p) do if k ~= "id" then MF.compat.coat[k] = val end end
      log("Coat preset: " .. tostring(p.name))
    end
  end
  ImGui.Separator()
  MF.compat.code = MF.compatEncodeCoat()
  ImGui.Text("SHARE CODE " .. MF.compat.code)
  if ImGui.Button("APPLY EXAMPLE CCP1 CODE") then
    MF.compatParseCoat("CCP1;P=C81E3C;S=202024;L=200;N=Night Runner")
    log("Applied Crystal Coat Picker example share code")
  end
  ImGui.Separator()
  textWrapped("Compatibility means shared public concepts, key names and CCP1 share codes, plus pcall-wrapped GetMod detection. It does not ship, patch, require or control those mods, and it does not make a 3D mech driveable inside Cyberpunk 2077. In-game piloting still needs meshes, rigs, animations, VO, the game itself and private base-mod APIs.")
end

registerForEvent("onInit", function()
  MF.visible = false
  log("MECHFALL // FORGE 77 loaded · " .. tostring(#(MF_DATA.roster or {})) .. " prefabs, " ..
    tostring(#MF.subsystems) .. " subsystem templates")
  log("Open the overlay with the CET hotkey binding: MECHFALL // FORGE 77")
  pcall(MF.compatProbe)
end)

registerForEvent("onDraw", function()
  if not MF.visible then return end
  if not ImGui.Begin("MECHFALL // FORGE 77 · CET TEST UI") then ImGui.End(); return end
  for i, name in ipairs(MF.tabs) do
    if ImGui.Button(name .. "##tab" .. i) then MF.tab = i end
    if i < #MF.tabs then ImGui.SameLine() end
  end
  ImGui.Separator()
  local ok, t = pcall(MF.compute, MF.activeDesignId)
  if not ok then
    ImGui.Text("Telemetry error: " .. tostring(t))
    ImGui.End()
    return
  end
  if MF.tab == 1 then drawHangar(t)
  elseif MF.tab == 2 then drawSystems(t)
  elseif MF.tab == 3 then drawForge(t)
  elseif MF.tab == 4 then drawReactor(t)
  elseif MF.tab == 5 then drawSettings()
  else drawCompat() end
  ImGui.End()
end)

-- Hotkey registration: supported by modern CET; wrapped so older builds still load.
pcall(function()
  registerHotkey("mechfall_forge_toggle", "MECHFALL // FORGE 77", function()
    MF.visible = not MF.visible
    log("Overlay " .. (MF.visible and "opened" or "closed"))
  end)
end)

return MF
